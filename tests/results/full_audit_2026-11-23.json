  "findings": [
    {
      "id": "F1",
      "priority": "P2",
      "title": "Default transpilation can produce full-state instructions rejected by the advertised backend",
      "file": "D:\\vscodeprojs\\zhiyuan\\flagquantum-qiskit\\src\\flagquantum_qiskit\\program.py",
      "line": 155,
      "related_lines": [
        165
      ],
      "trigger": "QuantumCircuit(2): x(0); swap(0,1); save_statevector(); transpile(circuit, FlagQuantumBackend(num_qubits=2)); backend.run(...). Default optimization level 2 elides SWAP and permutes save qargs to [1,0]. set_statevector has the same rejection.",
      "actual": "QiskitError for full-state instructions with complete but permuted qargs; levels 2 and 3 fail, levels 0 and 1 succeed.",
      "expected": "The standard transpile(..., backend); backend.run(...) workflow should execute supported full-width instructions emitted for that backend; explicit submitted-bit state semantics must be maintained without a second layout reversal.",
      "impact": "save_statevector/set_statevector after an elidable permutation; CPU and CUDA share compiler. No incorrect computed amplitude is established: execution is rejected.",
      "test_gap": "Existing transpile-save regression has no SWAP/permutation. GPU state-input test uses optimization_level=0.",
      "recommendation": "Define full-state qarg semantics consistently with the submitted-circuit contract, then accept complete permutations or prevent unsupported output through the backend compilation contract. Add default/2/3 transpile regression for save and set; do not blindly apply final_layout.",
      "evidence": [
        ".cache/full-audit/save-transpile-probe.json",
        ".cache/full-audit/state-input-transpile-probe.json"
      ],
      "layout_caveat": "For set_statevector, original Aer counts are 01:8 while the transpiled circuit executed by Aer gives 10:8. Aer accepting the compiled circuit is not proof of original logical equivalence. Full-state semantics or preservation of legitimate instruction ordering must be resolved before accepting permutations."
    },
    {
      "id": "F2",
      "priority": "P3",
      "title": "Benchmark double-FQ/single-Aer comparison uses an incorrectly strict tolerance",
      "file": "D:\\vscodeprojs\\zhiyuan\\flagquantum-qiskit\\benchmarks\\run_qasmbench.py",
      "line": 167,
      "trigger": "--precision double --aer-precision single; isolated qft_n4 only, warmups=0 repeats=1",
      "actual": "Both workers exit 0 and independently pass precision-appropriate accuracy checks; fq_vs_aer error 7.874369662175718e-8 exceeds threshold 1e-10, so runner exits 1.",
      "expected": "Cross-engine tolerance should reflect both precisions, or the unsupported precision combination should be rejected at argument validation.",
      "impact": "Reverse mixed-precision CLI combination only; saved double/double and single/double results unaffected.",
      "test_gap": "Formal tests do not execute benchmark CLI precision combinations.",
      "recommendation": "Use the larger applicable precision tolerance for cross-engine checks, or reject this combination explicitly.",
      "evidence": [
        ".cache/full-audit/benchmark-reverse-precision.json",
        ".cache/full-audit/benchmark-reverse-precision.log"
      ]
    },
